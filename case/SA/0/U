FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (49.22 13.35 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (49.22 13.35 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            freestream;
        freestreamValue uniform (49.22 13.35 0);
    }
    bottom
    {
        type            freestream;
        freestreamValue uniform (49.22 13.35 0);
    }
    airfoil
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
