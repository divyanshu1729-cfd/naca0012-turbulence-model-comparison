FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        // GAMG: algebraic multigrid — optimal for pressure in RANS
        solver          GAMG;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
        tolerance       1e-7;
        relTol          0.01;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-8;
        relTol          0.01;
    }

    nuTilda
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-8;
        relTol          0.01;
    }
}

SIMPLE
{
    // Bug fix: was 0 in tutorial → non-orthogonality error uncorrected
    // snappy mesh max non-orth will be ~50-60 deg → need 2 correctors
    nNonOrthogonalCorrectors 2;

    // Consistent SIMPLE (SIMPLEC): better convergence for external aero
    consistent          yes;

    residualControl
    {
        p               1e-5;
        U               1e-7;
        nuTilda         1e-7;
    }
}

relaxationFactors
{
    // Standard values for external RANS aerodynamics
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        nuTilda         0.7;
    }
}

