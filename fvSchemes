FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
//  PHASE 3 changes from steady:
//    1. ddtSchemes: steadyState → Euler   (1st-order implicit time integration)
//       Euler is unconditionally stable, appropriate for URANS startup.
//       Switch to 'backward' (2nd-order) after first stable cycle if desired.
//
//    2. divSchemes: remove 'bounded' keyword.
//       'bounded' is a SIMPLE-specific stabilisation that modifies the
//       divergence operator. It is inappropriate for time-accurate PIMPLE.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Euler: 1st-order implicit — unconditionally stable, starts cleanly
    // from the steady solution. Switch to 'backward' for 2nd-order accuracy
    // once periodicity is established (after ~1 shedding cycle).
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;

    limited         cellLimited Gauss linear 1;
    grad(U)         $limited;
    grad(k)         $limited;
    grad(omega)     $limited;
}

divSchemes
{
    default         none;

    // Removed 'bounded' — not appropriate for time-accurate PIMPLE
    div(phi,U)      Gauss linearUpwind grad(U);
    div(phi,k)      Gauss linearUpwind grad(k);
    div(phi,omega)  Gauss linearUpwind grad(omega);

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}

